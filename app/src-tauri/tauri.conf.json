{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taktische Zeichen Druckgenerator",
  "mainBinaryName": "TaktischeZeichenDruckgenerator",
  "version": "0.9.0",
  "identifier": "de.thw.taktische-zeichen-druckgenerator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run lizenzen && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Taktische Zeichen Druckgenerator",
        "width": 1400,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Druckvorbereitung taktischer Zeichen",
    "longDescription": "Bereitet taktische Zeichen (SVG/PNG) mit Beschriftung als Vektor-PDF, Schnittbogen oder PNG für den Druck auf.",
    "copyright": "GPL-3.0-or-later",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ]
      }
    },
    "resources": [
      "LIZENZEN-DRITTANBIETER.txt"
    ]
  }
}
